              <label for="firstName" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Prénom *</label>
              <input type="text" id="firstName" name="firstName" required
                class="w-full rounded-xl border border-black/[0.06] bg-white px-5 py-3.5 text-sm text-dbs-dark placeholder-dbs-dark/20 transition focus:border-dbs-purple/40 focus:outline-none dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-white/90" />
            </div>
            <div>
              <label for="lastName" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Nom</label>
              <input type="text" id="lastName" name="lastName"
                class="w-full rounded-xl border border-black/[0.06] bg-white px-5 py-3.5 text-sm text-dbs-dark placeholder-dbs-dark/20 transition focus:border-dbs-purple/40 focus:outline-none dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-white/90" />
            </div>
          </div>

          <!-- Email + Phone -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="email" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Email *</label>
              <input type="email" id="email" name="email" required
