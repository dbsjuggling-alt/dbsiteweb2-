---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { translate } from '../../i18n/translations';
const lang = 'fr';

const isSuccess = Astro.url.searchParams.get('success') === 'true';
---

{
  isSuccess ? (
    <BaseLayout lang={lang} page="home" title={"Merci ! | db's"}>
      <div class="py-24">
        <div class="mx-auto max-w-lg px-6 text-center">
          <div class="mb-6 flex justify-center">
            <div class="flex h-20 w-20 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30">
              <span class="text-4xl">✅</span>
            </div>
          </div>
          <h1 class="mb-3 text-3xl font-bold tracking-tight text-dbs-dark sm:text-4xl dark:text-white">
            Merci pour ta commande !
          </h1>
          <p class="mb-8 text-base text-dbs-dark/50 dark:text-white/30">
            Tu vas recevoir un email de confirmation dans quelques minutes avec tous les détails.
          </p>
          <div class="mx-auto max-w-sm rounded-2xl border border-black/[0.04] bg-white p-6 dark:border-white/[0.05] dark:bg-white/[0.03]">
            <p class="text-sm text-dbs-dark/40 dark:text-white/30">Commande en cours de préparation</p>
            <div class="mt-4 flex justify-center gap-1">
              <span class="h-2 w-2 animate-pulse rounded-full bg-dbs-purple"></span>
              <span class="h-2 w-2 animate-pulse rounded-full bg-dbs-purple" style="animation-delay:0.2s"></span>
              <span class="h-2 w-2 animate-pulse rounded-full bg-dbs-purple" style="animation-delay:0.4s"></span>
            </div>
          </div>
          <div class="mt-8">
            <a href="/fr/products" class="inline-flex items-center rounded-xl bg-dbs-dark px-6 py-3 text-sm font-semibold text-white no-underline transition hover:bg-dbs-dark/90 dark:bg-white dark:text-[#0d0d0f] dark:hover:bg-white/90">
              ← Retour aux produits
            </a>
          </div>
        </div>
      </div>
    </BaseLayout>
  ) : (
    <BaseLayout lang={lang} page="home" title={"Accueil | db's"}>
  <section class="relative overflow-hidden bg-white dark:bg-[#0d0d0f]">
    <div class="mx-auto max-w-[1224px] px-6 pb-20 pt-28 sm:pb-28 sm:pt-36">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="anim-fade-up">
          <span class="mb-5 inline-block rounded-full border border-dbs-purple/15 bg-dbs-purple/[0.04] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-dbs-purple dark:border-dbs-purple/30 dark:bg-dbs-purple/[0.08]">
            {translate(lang, 'hero.badge')}
          </span>
          <h1 class="text-[3.2rem] font-extrabold leading-[1.08] tracking-tight text-dbs-dark sm:text-[4.2rem] md:text-[5rem] dark:text-white">
            {translate(lang, 'hero.title1')}<br />
            <span class="bg-gradient-to-r from-dbs-purple to-violet-500 bg-clip-text text-transparent">
              {translate(lang, 'hero.title2')}
            </span>
          </h1>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/fr/store" class="hover-btn inline-flex items-center rounded-xl bg-dbs-dark px-7 py-3.5 text-sm font-semibold text-white no-underline dark:bg-white dark:text-[#0d0d0f] dark:hover:bg-white/90">
              {translate(lang, 'hero.shop')}
              <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/fr/products" class="inline-flex items-center rounded-xl border border-black/[0.08] px-7 py-3.5 text-sm font-semibold text-dbs-dark/60 no-underline transition hover:border-dbs-purple/30 hover:text-dbs-purple dark:border-white/[0.1] dark:text-white/50 dark:hover:text-dbs-purple">
              {translate(lang, 'hero.learn')}
            </a>
          </div>
        </div>

        <div class="anim-scale hidden lg:flex lg:justify-center" style="transition-delay: 200ms;">
          <div class="relative">
            <div class="absolute -inset-10 rounded-full bg-gradient-to-br from-dbs-purple/[0.06] to-violet-500/[0.04] blur-3xl dark:from-dbs-purple/[0.15] dark:to-violet-500/[0.1]"></div>
            <img
              src="https://cdn.zyrosite.com/cdn-ecommerce/store_01JHTCM0MJFETQMCPFTPG70789%2Fassets%2F1737126210199-balledbs.jpg"
              alt="Balle de jonglage db's — 70mm Blanc"
              class="relative z-10 h-80 w-80 rounded-full object-cover shadow-2xl shadow-black/[0.06] dark:shadow-black/30 sm:h-96 sm:w-96"
              loading="eager"
              width="384"
              height="384"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="h-5 w-5 text-dbs-dark/15 dark:text-white/10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 13l5 5 5-5M7 6l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </section>

  <section class="border-t border-black/[0.04] py-24 dark:border-white/[0.04]">
    <div class="mx-auto max-w-[1224px] px-6">
      <div class="mb-16 text-center anim-fade-up">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.2em] text-dbs-purple">
          {translate(lang, 'specs.heading')}
        </span>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-dbs-dark sm:text-4xl dark:text-white">
          {translate(lang, 'specs.subtitle')}
        </h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5 anim-stagger">
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">70mm</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">Pressurisé</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">Blanc</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">Sable Ultra-Fin</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">65g</h3>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-black/[0.04] bg-dbs-purple/[0.02] py-16 dark:border-white/[0.04] dark:bg-dbs-purple/[0.04]">
    <div class="mx-auto max-w-[1224px] px-6 text-center anim-fade-up">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-dbs-purple">{translate(lang, 'insta.heading')}</p>
      <p class="mt-1 text-base text-dbs-dark/40 dark:text-white/30">{translate(lang, 'insta.subtitle')}</p>
      <div class="mt-5 flex items-center justify-center">
        <a href="https://instagram.com/dbsjuggling" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl border border-black/[0.06] px-5 py-2.5 text-sm font-medium text-dbs-dark/50 no-underline transition hover:border-dbs-purple/30 hover:text-dbs-purple dark:border-white/[0.08] dark:text-white/40 dark:hover:text-dbs-purple">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/></svg>
          @dbsjuggling
        </a>
      </div>
    </div>
  </section>
    </BaseLayout>
  )}
