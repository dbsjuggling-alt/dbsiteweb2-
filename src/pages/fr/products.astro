---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { translate } from '../../i18n/translations';
const lang = 'fr';
---

<BaseLayout lang={lang} page="products" title={"Produits | db's"}>
  <div class="py-24">
    <div class="mx-auto max-w-[1224px] px-6">
      <div class="mb-16 text-center anim-fade-up">
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-dbs-dark sm:text-4xl dark:text-white">{translate(lang, 'products.subtitle')}</h1>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 anim-stagger">
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">70mm</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">Pressurisé</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">Blanc</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">Sable Ultra-Fin</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">65g</h3>
        </div>
        <div class="anim-item anim-fade-up hover-lift rounded-2xl border border-black/[0.04] bg-white p-8 text-center dark:border-white/[0.05] dark:bg-white/[0.03]">
          <div class="mx-auto mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-dbs-purple/[0.06] dark:bg-dbs-purple/[0.12]">
            <svg class="h-5 w-5 text-dbs-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3 class="text-lg font-bold text-dbs-dark dark:text-white/90">Soft-Touch</h3>
        </div>
      </div>

      <div class="mt-16 text-center anim-fade-up">
        <p class="mb-5 text-base text-dbs-dark/40 dark:text-white/30">{translate(lang, 'products.cta')}</p>
        <a href="/fr/store" class="hover-btn inline-flex items-center rounded-xl bg-dbs-dark px-7 py-3.5 text-sm font-semibold text-white no-underline dark:bg-white dark:text-[#0d0d0f] dark:hover:bg-white/90">
          {translate(lang, 'products.ctaBtn')}
          <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>