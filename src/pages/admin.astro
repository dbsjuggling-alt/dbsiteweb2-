          </div>

          <div>
            <label for="tracking2" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Numéro de suivi *</label>
            <input type="text" id="tracking2" name="tracking" required
              class="w-full rounded-xl border border-black/[0.06] bg-white px-5 py-3.5 text-sm text-dbs-dark placeholder-dbs-dark/20 transition focus:border-dbs-purple/40 focus:outline-none dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-white/90 dark:placeholder-white/15 font-mono tracking-wider"
              placeholder="7A99999999999" />
          </div>

          <div>
            <label for="carrier2" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Transporteur</label>
            <select id="carrier2" name="carrier"
