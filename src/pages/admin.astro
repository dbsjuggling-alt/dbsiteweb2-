            </div>
            <div>
              <label for="postalCode" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">CP *</label>
              <input type="text" id="postalCode" name="postalCode" required
