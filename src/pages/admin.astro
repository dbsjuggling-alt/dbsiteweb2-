                placeholder="33420" />
            </div>
          </div>

          <!-- Pays -->
          <div>
            <label for="country" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Pays</label>
            <select id="country" name="country"
              class="w-full rounded-xl border border-black/[0.06] bg-white px-5 py-3.5 text-sm text-dbs-dark transition focus:border-dbs-purple/40 focus:outline-none dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-white/90">
              <option value="FR">France</option>
              <option value="BE">Belgique</option>
              <option value="CH">Suisse</option>
              <option value="LU">Luxembourg</option>
              <option value="DE">Allemagne</option>
              <option value="IT">Italie</option>
              <option value="ES">Espagne</option>
            </select>
          </div>

          <!-- Transporteur -->
          <div>
            <label for="carrier" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Transporteur</label>
            <select id="carrier" name="carrier"
              class="w-full rounded-xl border border-black/[0.06] bg-white px-5 py-3.5 text-sm text-dbs-dark transition focus:border-dbs-purple/40 focus:outline-none dark:border-white/[0.08] dark:bg-white/[0.03] dark:text-white/90">
              <option value="Mondial Relay">Mondial Relay</option>
              <option value="Colissimo">Colissimo</option>
              <option value="Chronopost">Chronopost</option>
              <option value="DPD">DPD</option>
              <option value="La Poste">La Poste</option>
            </select>
          </div>

          <!-- Quantité -->
          <div>
            <label for="quantity" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Quantité</label>
