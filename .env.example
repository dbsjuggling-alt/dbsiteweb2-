# Stripe
STRIPE_SECRET_KEY=rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (transactional emails)
RESEND_API_KEY=re_...
# Sender email (must be verified in Resend). Default: onboarding@resend.dev
# FROM_EMAIL=onboarding@resend.dev

# Admin page token — change this ! Visit /admin?token=TON_TOKEN
ADMIN_TOKEN=jongle123

# SendCloud — webhook secret (set in SendCloud dashboard → Settings → Webhooks)
# SENDCLOUD_WEBHOOK_SECRET=your_secret_here

# SendCloud API — create shipments with Mondial Relay
# Get both keys from SendCloud Dashboard → Settings → API Keys
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_PRIVATE_KEY=

# Boxtal API v3
BOXTAL_ACCESS_KEY=
BOXTAL_SECRET_KEY=
BOXTAL_SHIPPING_OFFER_CODE=
# Set to 'true' for sandbox (api.boxtal.build)
BOXTAL_SANDBOX=true

# Sender (your) address — used for shipping labels
SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SENDER_COMPANY=db's
SENDER_EMAIL=dbsjuggling@gmail.com
SENDER_PHONE=
SENDER_NUMBER=
SENDER_STREET=
SENDER_CITY=
SENDER_POSTAL_CODE=
SENDER_COUNTRY=FR

# Site
