            🚚 Créer l'expédition + envoyer l'email
          </button>
        </form>
      </div>

      <!-- Tab: Manual email -->
      <div id="panel-email" class="space-y-5 anim-fade-up" style="display:none;">
        <p class="mb-6 text-sm text-dbs-dark/50 dark:text-white/30">
          Envoie un email de suivi avec un numéro de tracking déjà connu.
        </p>

        <form method="POST" class="space-y-5">
          <input type="hidden" name="action" value="email" />

          <div>
            <label for="email2" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.1em] text-dbs-dark/40 dark:text-white/30">Email du client *</label>
            <input type="email" id="email2" name="email" required
