---
/**
 * Admin page — hidden behind ADMIN_TOKEN.
 * URL: /admin?token=TON_TOKEN
 *
 * Two actions:
 *   1. Send shipping notification email manually
 *   2. Create a SendCloud shipment + auto-send email
 */
import 'dotenv/config';
import BaseLayout from '../layouts/BaseLayout.astro';

const token = Astro.url.searchParams.get('token');
const adminToken = process.env.ADMIN_TOKEN || '';

if (!token || token !== adminToken) {
  return Astro.redirect('/404');
}

let message: { type: 'success' | 'error'; text: string } | null = null;
let shipmentData: { trackingNumber: string; carrier: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action') as string;

  if (action === 'email') {
    // === Send shipping notification email only ===
    const customerEmail = form.get('email') as string;
    const customerName = form.get('name') as string;
    const trackingNumber = form.get('tracking') as string;
    const carrier = (form.get('carrier') as string) || 'Colissimo';
    const trackingUrl = (form.get('trackingUrl') as string) || undefined;
    const quantity = parseInt(form.get('quantity') as string, 10) || 1;
    const orderId = (form.get('orderId') as string) || undefined;

    if (!customerEmail || !customerName || !trackingNumber) {
      message = { type: 'error', text: '❌ Email, nom et numéro de suivi sont requis.' };
    } else {
      try {
        const { sendShippingNotification } = await import('../lib/email.ts');
        await sendShippingNotification({
          customerEmail, customerName, trackingNumber, carrier, trackingUrl, quantity, orderId,
        });
        message = { type: 'success', text: `✅ Email envoyé à ${customerEmail} avec le suivi ${trackingNumber}` };
      } catch (err: any) {
        message = { type: 'error', text: `❌ Erreur : ${err.message}` };
      }
    }
  } else if (action === 'shipment') {
    // === Create SendCloud shipment + auto-send email ===
    const firstName = form.get('firstName') as string;
    const lastName = form.get('lastName') as string;
    const customerName = `${firstName} ${lastName}`.trim();
    const customerEmail = form.get('email') as string;
    const phone = form.get('phone') as string;
    const street = form.get('street') as string;
    const houseNumber = form.get('houseNumber') as string;
    const city = form.get('city') as string;
    const postalCode = form.get('postalCode') as string;
    const country = (form.get('country') as string) || 'FR';
    const carrier = (form.get('carrier') as string) || 'Mondial Relay';
    const quantity = parseInt(form.get('quantity') as string, 10) || 1;
    const orderId = (form.get('orderId') as string) || undefined;

    if (!customerEmail || !firstName || !street || !houseNumber || !city || !postalCode) {
      message = { type: 'error', text: '❌ Tous les champs obligatoires doivent être remplis.' };
    } else {
      try {
        const { createShipment } = await import('../lib/sendcloud.ts');

        const result = await createShipment(
          {
            name: `${firstName} ${lastName || firstName}`.trim(),
            company_name: undefined,
            address_line_1: street,
            house_number: houseNumber,
            postal_code: postalCode,
            city,
            country_code: country,
            email: customerEmail,
            phone_number: phone || undefined,
          },
          carrier,
          [
            {
              weight: { value: Math.max(0.1, quantity * 0.07).toFixed(3), unit: 'kg' },
              dimensions: { length: '28', width: '20', height: '10', unit: 'cm' },
              description: `Balles de jonglage × ${quantity}`,
            },
          ],
          orderId || undefined,
        );

        const trackingNumber = result.data.parcels?.[0]?.tracking_number || '';
        const trackingUrl = result.data.parcels?.[0]?.tracking_url || '';
        const carrierName = result.data.carrier?.name || carrier;

        // Auto-send the email
        const { sendShippingNotification } = await import('../lib/email.ts');
        await sendShippingNotification({
          customerEmail, customerName, trackingNumber, carrier: carrierName, trackingUrl, quantity, orderId,
        });

        // Save order in our records
        const { saveOrder } = await import('../lib/orders.ts');
        await saveOrder({
          stripeSessionId: orderId || `manual_${Date.now()}`,
          customerEmail, customerName, quantity,
          total: quantity * 5 + 0.5, // balls + shipping (0.50€)
          shippingAddress: `${houseNumber} ${street}`,
          city, postalCode, country,
          carrier: carrierName,
          trackingNumber,
          status: 'shipped',
          createdAt: new Date().toISOString(),
        });

        message = {
          type: 'success',
          text: `✅ Expédition créée + email envoyé à ${customerEmail} — Suivi : ${trackingNumber}`,
        };
        shipmentData = { trackingNumber, carrier: carrierName };
      } catch (err: any) {
        message = { type: 'error', text: `❌ Erreur SendCloud : ${err.message}` };
      }
    }
  }
}
---

<BaseLayout lang="fr" page="admin" title="Admin — db's Juggling">
  <div class="py-24">
    <div class="mx-auto max-w-lg px-6">

      <div class="mb-14 text-center anim-fade-up">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.2em] text-dbs-purple">ADMIN</span>
        <h1 class="text-3xl font-bold tracking-tight text-dbs-dark sm:text-4xl dark:text-white">
          Gestion des expéditions
        </h1>
      </div>

      {
        message && (
          <div class={`mb-8 rounded-xl px-5 py-3 text-sm font-medium ${
            message.type === 'success'
              ? 'bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400'
              : 'bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400'
          }`}>
            {message.text}
            {shipmentData && (
              <p class="mt-2 font-mono text-xs">{shipmentData.trackingNumber} — {shipmentData.carrier}</p>
            )}
          </div>
        )
      }

      <!-- Tabs -->
      <div class="mb-8 flex gap-2 border-b border-black/[0.06] pb-0 dark:border-white/[0.06]">
        <button id="tab-create" class="tab-btn active px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.1em] text-dbs-purple border-b-2 border-dbs-purple" onclick="switchTab('create')">Créer expédition</button>
