      </div>

    </div>
  </div>
</BaseLayout>

<script>
function switchTab(name) {
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.classList.remove('active', 'text-dbs-purple', 'border-dbs-purple');
    b.classList.add('text-dbs-dark/40', 'border-transparent', 'dark:text-white/30');
  });
  document.getElementById('tab-' + name).classList.add('active', 'text-dbs-purple', 'border-dbs-purple');
  document.getElementById('tab-' + name).classList.remove('text-dbs-dark/40', 'border-transparent', 'dark:text-white/30');

  document.getElementById('panel-create').style.display = name === 'create' ? '' : 'none';
  document.getElementById('panel-email').style.display = name === 'email' ? '' : 'none';
}
</script>

<style>
  .anim-fade-up { animation: fadeUp 0.5s ease-out both; }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>